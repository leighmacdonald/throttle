# Copy to .env to override defaults (docker compose reads .env automatically).
MYSQL_ROOT_PASSWORD=rootsecret
DB_NAME=throttle
DB_USER=throttle
DB_PASSWORD=throttle
# Host port Caddy listens on for HTTP (bound to 0.0.0.0).
HTTP_PORT=80
# Host port Caddy listens on for HTTPS (bound to 0.0.0.0, used when CF_API_TOKEN is set).
HTTPS_PORT=443
# Hostname the app thinks it runs as (OpenID return_to, trusted-host check).
# Set to your domain (e.g., throttle.example.com) when using Cloudflare DNS.
THROTTLE_HOSTNAME=localhost
THROTTLE_DEBUG=false
# Regenerate app/config.php from env on every container start.
THROTTLE_FORCE_CONFIG=1
# RRD graphs: munin-compatible host prefix + update interval (seconds).
MUNIN_HOST=throttle
GRAPH_INTERVAL=300
# Cloudflare API token with "Zone:DNS:Edit" permissions for the domain.
# When set, Caddy provisions TLS via Let's Encrypt using the DNS challenge.
# Get a token at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
